{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://review-hub.invalid/schemas/common.schema.json",
  "title": "Review Engine shared definitions",
  "description": "Types shared by every session and ledger file. The .invalid host is never fetched; it only gives refs a base URI.",
  "$defs": {
    "schema_version": {
      "description": "Version of these schemas the record was written against.",
      "const": "0.1"
    },
    "timestamp": {
      "description": "ISO 8601 date-time with an explicit UTC offset.",
      "type": "string",
      "format": "date-time",
      "pattern": "(Z|[+-]\\d{2}:\\d{2})$"
    },
    "session_id": {
      "description": "Name of the session folder: <YYYY-MM-DD>-<slug>.",
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}-[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "artifact_hash": {
      "description": "sha256 over the artifact snapshot manifest (sorted lines of '<relative path>\\t<sha256 of file>').",
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "stage_id": {
      "description": "Stage id as declared in the type's TYPE.md, e.g. 'measurement'.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "type_id": {
      "description": "Review type folder name, e.g. 'research-report'.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "decision_id": {
      "type": "string",
      "pattern": "^D\\d{2,}$"
    },
    "claim_id": {
      "type": "string",
      "pattern": "^C\\d{2,}$"
    },
    "finding_id": {
      "type": "string",
      "pattern": "^F\\d{3,}$"
    },
    "feedback_id": {
      "type": "string",
      "pattern": "^FB\\d{4,}$"
    },
    "change_id": {
      "type": "string",
      "pattern": "^R\\d{3,}$"
    },
    "message_id": {
      "type": "string",
      "pattern": "^M\\d{4,}$"
    },
    "incident_id": {
      "type": "string",
      "pattern": "^I-\\d{8}-\\d{2,}$"
    },
    "severity": {
      "description": "S1 changes the main conclusion or invalidates the design; S2 changes a specific statement; S3 is wording only.",
      "enum": [
        "S1",
        "S2",
        "S3"
      ]
    },
    "verifiability": {
      "description": "V: checkable against ground truth. J: judgement. J+V: judgement with checkable parts.",
      "enum": [
        "V",
        "J",
        "J+V"
      ]
    },
    "tier": {
      "enum": [
        "light",
        "standard",
        "deep"
      ]
    },
    "rel_path": {
      "description": "Path relative to the session folder (for artifact/ and copied ground truth) or to the workspace root (for ledger records). Never absolute, never '..'.",
      "type": "string",
      "minLength": 1,
      "not": {
        "pattern": "^/|(^|/)\\.\\.(/|$)"
      }
    },
    "text_quote_anchor": {
      "description": "Where in the artifact something sits. In the spirit of the W3C Web Annotation TextQuoteSelector: exact text plus enough context to relocate it after the artifact is rewritten.",
      "type": "object",
      "required": [
        "path",
        "exact"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "$ref": "#/$defs/rel_path",
          "description": "File inside the session's artifact/ snapshot."
        },
        "exact": {
          "type": "string",
          "minLength": 1
        },
        "prefix": {
          "type": "string",
          "description": "Up to ~32 characters immediately before exact."
        },
        "suffix": {
          "type": "string",
          "description": "Up to ~32 characters immediately after exact."
        },
        "line_hint": {
          "type": "integer",
          "minimum": 1,
          "description": "Line number in the version the anchor was made against. A hint only; exact+prefix+suffix win."
        }
      }
    },
    "evidence": {
      "description": "A pointer into a source of truth. A finding without at least one of these is dropped.",
      "oneOf": [
        {
          "$ref": "#/$defs/evidence_file"
        },
        {
          "$ref": "#/$defs/evidence_data"
        },
        {
          "$ref": "#/$defs/evidence_command"
        },
        {
          "$ref": "#/$defs/evidence_quote"
        }
      ]
    },
    "evidence_file": {
      "description": "Lines in a code, log, stats or text file.",
      "type": "object",
      "required": [
        "kind",
        "path",
        "line_start",
        "excerpt"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "file"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "line_start": {
          "type": "integer",
          "minimum": 1
        },
        "line_end": {
          "type": "integer",
          "minimum": 1
        },
        "excerpt": {
          "type": "string",
          "minLength": 1
        },
        "note": {
          "type": "string"
        }
      }
    },
    "evidence_data": {
      "description": "A value in a data file, addressed by key (column/row filter, JSON pointer, sheet!cell...).",
      "type": "object",
      "required": [
        "kind",
        "path",
        "key",
        "value"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "data"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "key": {
          "type": "string",
          "minLength": 1
        },
        "value": {},
        "note": {
          "type": "string"
        }
      }
    },
    "evidence_command": {
      "description": "A command that was actually run, with its output.",
      "type": "object",
      "required": [
        "kind",
        "command",
        "output_excerpt"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "command"
        },
        "command": {
          "type": "string",
          "minLength": 1
        },
        "cwd": {
          "type": "string"
        },
        "exit_code": {
          "type": "integer"
        },
        "output_excerpt": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "evidence_quote": {
      "description": "Quoted original text from literature or another document.",
      "type": "object",
      "required": [
        "kind",
        "source",
        "text"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "quote"
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "description": "Citation, URL, DOI or file path."
        },
        "locator": {
          "type": "string",
          "description": "Page, section or line."
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "note": {
          "type": "string"
        }
      }
    },
    "record_base": {
      "description": "Fields every JSONL record carries.",
      "type": "object",
      "required": [
        "schema_version",
        "id",
        "created_at",
        "session_id"
      ],
      "properties": {
        "schema_version": {
          "$ref": "#/$defs/schema_version"
        },
        "id": {
          "type": "string"
        },
        "created_at": {
          "$ref": "#/$defs/timestamp"
        },
        "session_id": {
          "$ref": "#/$defs/session_id"
        }
      }
    }
  }
}
